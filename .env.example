# 仙加味 LINE OA 正式環境變數範例

# LINE Messaging API｜必要
CHANNEL_ACCESS_TOKEN=
CHANNEL_SECRET=

# Rich Menu 正式顯示權威
# 正式環境維持 oa-manager；只有人工明確切換備援時才使用 messaging-api
LINE_RICH_MENU_AUTHORITY=oa-manager

# CRM／外部服務｜僅實際啟用時設定
CRM_URL=
CRM_TIMEOUT_MS=8000

# LINE 對話狀態
STATE_TTL_MS=86400000
STATE_CLEANUP_INTERVAL_MS=3600000
MAX_STATE_ENTRIES=10000

# Render / local runtime
PORT=3000

# 注意：ERP、貼文中心、Facebook／Instagram／LINE VOOM 等社群發布憑證
# 不屬於 TS-LINE 正式啟動必要設定，應由各自正式系統管理，不再混入本檔。
